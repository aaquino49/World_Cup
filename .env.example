# Copy this to .env for local development (never commit .env)

# Football data API (football-data.org — free tier)
FOOTBALL_API_KEY=your_api_key_here

# Admin credentials (2 admins supported)
ADMIN1_EMAIL=alejo@example.com
ADMIN1_PASSWORD=choose_a_strong_password

ADMIN2_EMAIL=alex@example.com
ADMIN2_PASSWORD=choose_a_strong_password

# JWT signing secret — generate a random 32+ char string
JWT_SECRET=replace_with_random_secret_string_here

# SQLite database path
# On Railway with a Volume mounted at /data:
DB_PATH=/data/worldcup.db
# For local development:
# DB_PATH=./worldcup.db

# Submission deadline (ISO 8601 UTC) — default is Jun 11 kickoff
# SUBMISSION_DEADLINE=2026-06-11T18:00:00.000Z
